# Copy this file to .env and fill in real values before running locally.
# docker-compose reads .env automatically.
# For k8s, values are injected via Secrets (see k8s/<namespace>/<service>/secret.yaml).

# ── Loki ──────────────────────────────────────────────────────────────────────
# Leave empty to disable Loki (logs go to stdout only).
# LOKI_APP_NAME defaults to the service name ("submission-api", "build-worker").
# Override per-process in k8s via the Deployment/Job env block.
LOKI_URL=http://localhost:3100
# LOKI_APP_NAME=submission-api

# ── Prometheus metrics ────────────────────────────────────────────────────────
# Problem: services now expose /metrics and need stable local ports for
# Prometheus. Fix: set METRICS_PORT per process when two workers run together.
ENVIRONMENT=local
SERVICE_VERSION=dev
LOG_LEVEL=info
METRICS_PORT=9090

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# docker-compose exposes postgres on 5433 (not 5432) to avoid conflicts with a local install.
DATABASE_URL=postgres://iicpc:iicpc@localhost:5433/iicpc

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=submissions
MINIO_USE_SSL=false

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Leave empty to disable Kafka publishing (submission-api and build-worker run in no-op mode).
# Add a Kafka service to docker-compose to enable full local testing.
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=build-worker

# ── Harbor (staging registry) ─────────────────────────────────────────────────
# Kaniko pushes built images here. Trivy and Syft read from here.
HARBOR_STAGING_ENDPOINT=harbor-staging.example.com
HARBOR_PROJECT=iicpc
HARBOR_USER=robot$iicpc
HARBOR_PASSWORD=changeme

# ── Harbor (production registry) ──────────────────────────────────────────────
# Spawner promotes verified images here via crane.Copy.
# Leave empty to skip promotion (safe for local dev and CI).
HARBOR_PRODUCTION_ENDPOINT=harbor.example.com

# ── build-worker / spawner (k8s prod only) ────────────────────────────────────
# SPAWNER_IMAGE is used as the fetcher init container in kaniko build Jobs.
# The three tool images default to pinned upstream versions; override to change.
SPAWNER_IMAGE=harbor.example.com/iicpc/spawner:latest
K8S_NAMESPACE=build
# KANIKO_IMAGE=gcr.io/kaniko-project/executor:v1.23.2
# TRIVY_IMAGE=aquasec/trivy:0.51.4
# SYFT_IMAGE=anchore/syft:v1.4.1

# ── bot-fleet worker (Rust · botworker node pool) ─────────────────────────────
# worker_id comes from HOSTNAME (the pod name in k8s); no env needed.
# MAX_BOTS_PER_WORKER caps the tasks (= TCP connections) one worker accepts in a
# single WorkloadSpec. It must be >= the controller's MaxTasksPerWorker (1000),
# which is how the controller shards scenarios; a lower value makes the worker
# reject valid specs and the controller's bot.ready fan-in times out. 1000 is
# also the hard ceiling enforced by the worker, so this knob can only lower the
# per-pod load below 1000, never raise it above.
# MAX_BOTS_PER_WORKER=1000
# Telemetry aggregator tuning (see TelemetrySink). channel_capacity must be >=
# batch_size or the worker fails its startup config validation.
# TELEMETRY_BATCH_SIZE=4096
# TELEMETRY_CHANNEL_CAPACITY=65536
# TELEMETRY_FLUSH_INTERVAL_MS=5
