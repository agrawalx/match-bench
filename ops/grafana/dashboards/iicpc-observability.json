          "refId": "A"
        }
      ],
      "title": "pgx Pool Saturation",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iicpc-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
