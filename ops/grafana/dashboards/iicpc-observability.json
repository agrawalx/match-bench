      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (service, path, status) (rate(iicpc_http_requests_total[5m]))",
          "legendFormat": "{{service}} {{path}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iicpc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service, path) (rate(iicpc_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}} {{path}} p95",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iicpc-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (service, operation, result) (rate(iicpc_db_query_total[5m]))",
