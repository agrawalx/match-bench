# Copy this file to .env and fill in real values before running locally.
# docker-compose reads .env automatically.
# For k8s, values are injected via Secrets (see k8s/<namespace>/<service>/secret.yaml).

# ── Loki ──────────────────────────────────────────────────────────────────────
# Leave empty to disable Loki (logs go to stdout only).
# LOKI_APP_NAME defaults to the service name ("submission-api", "build-worker").
# Override per-process in k8s via the Deployment/Job env block.
LOKI_URL=http://localhost:3100
# LOKI_APP_NAME=submission-api

# ── Prometheus metrics ────────────────────────────────────────────────────────
# Problem: services now expose /metrics and need stable local ports for
# Prometheus. Fix: set METRICS_PORT per process when two workers run together.
ENVIRONMENT=local
SERVICE_VERSION=dev
LOG_LEVEL=info
METRICS_PORT=9090

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# docker-compose exposes postgres on 5433 (not 5432) to avoid conflicts with a local install.
DATABASE_URL=postgres://iicpc:iicpc@localhost:5433/iicpc

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=submissions
MINIO_USE_SSL=false

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Leave empty to disable Kafka publishing (submission-api and build-worker run in no-op mode).
# Add a Kafka service to docker-compose to enable full local testing.
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=build-worker

# ── Harbor (staging registry) ─────────────────────────────────────────────────
# Kaniko pushes built images here. Trivy and Syft read from here.
HARBOR_STAGING_ENDPOINT=harbor-staging.example.com
HARBOR_PROJECT=iicpc
HARBOR_USER=robot$iicpc
HARBOR_PASSWORD=changeme

# ── Harbor (production registry) ──────────────────────────────────────────────
# Spawner promotes verified images here via crane.Copy.
# Leave empty to skip promotion (safe for local dev and CI).
HARBOR_PRODUCTION_ENDPOINT=harbor.example.com

# ── build-worker / spawner (k8s prod only) ────────────────────────────────────
# SPAWNER_IMAGE is used as the fetcher init container in kaniko build Jobs.
# The three tool images default to pinned upstream versions; override to change.
SPAWNER_IMAGE=harbor.example.com/iicpc/spawner:latest
K8S_NAMESPACE=build
# KANIKO_IMAGE=gcr.io/kaniko-project/executor:v1.23.2
# TRIVY_IMAGE=aquasec/trivy:0.51.4
# SYFT_IMAGE=anchore/syft:v1.4.1

# ── bot-fleet worker (Rust · botworker node pool) ─────────────────────────────
# worker_id comes from HOSTNAME (the pod name in k8s); no env needed.
# MAX_BOTS_PER_WORKER caps the tasks (= TCP connections) one worker accepts in a
# single WorkloadSpec. It is the sole per-pod task ceiling (the old hard-coded
# 1000 cap was removed), so it CAN be raised to pin a large, high-RPS scenario
# onto a single pod for capacity testing. It MUST be >= the controller's
# MAX_TASKS_PER_WORKER, or the worker rejects a sharded spec and the controller's
# bot.ready fan-in times out. Default 1000.
# MAX_BOTS_PER_WORKER=1000
#
# MAX_POLL_INTERVAL_MS is the Kafka consumer's max.poll.interval.ms AND the L39
# wall-time guard, kept identical so they never drift. The worker does not poll
# while a workload runs (barrier wait + scenario duration + drain), so this must
# exceed that whole wall time or Kafka rebalances the partition mid-run and the
# assignment is re-delivered/re-executed. Raise it for long or high-RPS runs;
# librdkafka's background heartbeat still proves liveness, so a large value does
# not delay failure detection. Default 300000 (5 min); the k8s deployment sets
# 1800000 (30 min) so 5-min+ tests run cleanly.
# MAX_POLL_INTERVAL_MS=300000
#
# Telemetry aggregator tuning (see TelemetrySink). channel_capacity must be >=
# batch_size or the worker fails its startup config validation.
# TELEMETRY_BATCH_SIZE=4096
# TELEMETRY_CHANNEL_CAPACITY=65536
# TELEMETRY_FLUSH_INTERVAL_MS=5

# ── bot-fleet-controller (Go · benchmark namespace) ───────────────────────────
# MAX_TASKS_PER_WORKER is the per-pod task ceiling that drives fan-out:
#   WorkerCount = ceil(total_tasks_in_scenario / MAX_TASKS_PER_WORKER)
# Tasks shard round-robin across WorkerCount pods. This is the per-pod
# concentration knob:
#   - Raise it ABOVE a scenario's task count  -> WorkerCount=1: ALL load on ONE
#     pod (measure a single pod's ceiling, or run small tests cheaply).
#   - Lower it                                  -> more pods share the load.
# HARD COUPLING: WorkerCount must be <= the bot-fleet replica count, because each
# pod runs assignments serially — if WorkerCount exceeds the pod count, a pod is
# handed two assignments and the second misses its barrier. Scale the
# bot-fleet-worker Deployment to >= the WorkerCount you expect. Also keep the
# worker's MAX_BOTS_PER_WORKER >= this value. Default 1000.
# MAX_TASKS_PER_WORKER=1000
#
# Cluster-wide lifecycle deadlines (not per-scenario). Defaults shown.
# DEPLOY_DEADLINE=60s
# READY_DEADLINE=30s
# BARRIER_SAFETY_GAP=500ms

# ── submission-api scenario builder (load-shape knobs) ────────────────────────
# The three canonical scenarios (constant, spike, ramp) are generated from these
# at startup. The participant mix (HFT 60% / Retail 25% / Institutional 15%) and
# per-bot rates (HFT 1000, Retail 5, Inst 300 rps) are FIXED; you tune the TOTAL
# RPS budget and durations, and the bot COUNTS fall out of (budget / per-bot rate).
#
# duration knobs (whole seconds):
# CONSTANT_DURATION_S=60
# SPIKE_DURATION_S=60
# RAMP_DURATION_S=180
# aggregate-RPS knobs (orders/sec):
# CONSTANT_TOTAL_RPS=10000      # constant test + spike baseline
# SPIKE_PEAK_RPS=50000          # aggregate during the spike burst (>= CONSTANT_TOTAL_RPS)
# RAMP_PEAK_RPS=90000           # aggregate at the top of the ramp staircase
# spike-shape knobs (whole seconds; pre-window + burst must fit in SPIKE_DURATION_S):
# SPIKE_PREWINDOW_S=25          # hold at baseline before the burst
# SPIKE_BURST_S=10             # how long the burst lasts
#
# APPLYING CHANGES: seeding is INSERT ... ON CONFLICT DO NOTHING by default, so a
# changed value does NOT touch an already-seeded scenarios table on restart.
# Set RESEED_SCENARIOS=true to upsert (rewrite duration + task_specs from the env
# above, preserving each scenario_id) on the next restart. Leave it false in
# normal operation so a hand-tuned row is never clobbered.
# RESEED_SCENARIOS=false
#
# Higher total RPS just means more bots (= more sockets). Mind the per-pod socket
# count when pinning to one pod: e.g. 50k total -> ~2,555 sockets; 100k -> ~5,110.
#
# ── workload recipes ──────────────────────────────────────────────────────────
# Set these on the submission-api Deployment (env block) + RESEED_SCENARIOS=true,
# then restart submission-api. In k8s:
#   kubectl set env deploy/submission-api -n platform \
#     CONSTANT_DURATION_S=300 CONSTANT_TOTAL_RPS=20000 RESEED_SCENARIOS=true
#
# (a) Quick smoke — short + light, for pipeline checks:
#   CONSTANT_DURATION_S=30  SPIKE_DURATION_S=30  RAMP_DURATION_S=60
#   CONSTANT_TOTAL_RPS=2000 SPIKE_PEAK_RPS=8000  RAMP_PEAK_RPS=9000
#
# (b) Sustained 5-minute soak at moderate load:
#   CONSTANT_DURATION_S=300 SPIKE_DURATION_S=300 RAMP_DURATION_S=300
#   CONSTANT_TOTAL_RPS=20000 SPIKE_PEAK_RPS=60000 RAMP_PEAK_RPS=90000
#   (also bump the worker's MAX_POLL_INTERVAL_MS so the 5-min run doesn't rebalance)
#
# (c) High-throughput stress (fan across the fleet — keep MAX_TASKS_PER_WORKER at
#     the default and scale bot-fleet-worker replicas to >= ceil(tasks/1000)):
#   CONSTANT_DURATION_S=120 SPIKE_DURATION_S=120 RAMP_DURATION_S=180
#   CONSTANT_TOTAL_RPS=50000 SPIKE_PEAK_RPS=200000 RAMP_PEAK_RPS=300000

# ── telemetry-ingester (Rust · benchmark namespace, single replica) ───────────
# Consumes orders.sent + orders.acked, snapshots per-(session,wave) latency to
# TimescaleDB + Redis every SNAPSHOT_INTERVAL_MS.
# KAFKA_CONSUMER_GROUP=telemetry-ingester
# TimescaleDB (metrics) — SEPARATE instance from the metadata postgres. Local
# docker-compose exposes it on host port 5434.
# TIMESCALE_URL=postgres://iicpc:iicpc@localhost:5434/metrics
# REDIS_URL=redis://localhost:6379
# Ramp wave bucket width (ms). wave_index = floor((t - session_start)/WAVE).
# WAVE_DURATION_MS=20000
# How often to snapshot windows to TimescaleDB + Redis.
# SNAPSHOT_INTERVAL_MS=1000
