# Copy to .env for local runs. Docker Compose reads this file automatically.

# Shared local services
DATABASE_URL=
TIMESCALE_URL=
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092,localhost:9095,localhost:9096

# Credential values are intentionally blank; set them in local .env or secrets.

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=submissions
MINIO_USE_SSL=false
MINIO_CREATE_BUCKET_IF_MISSING=true

# Logging and metrics
LOKI_URL=http://localhost:3100
ENVIRONMENT=local
SERVICE_VERSION=dev
LOG_LEVEL=info
METRICS_PORT=9090
METRICS_ADDR=0.0.0.0:9090

# Auth API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,http://localhost:3001/auth/callback
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Platform APIs
PROMETHEUS_URL=http://localhost:9090
AUTH_REQUIRED=false

# Build worker and spawner
KAFKA_GROUP_ID=build-worker
K8S_NAMESPACE=build
SPAWNER_IMAGE=harbor.example.com/iicpc/spawner:latest

# Registry used by build jobs. Leave production empty to skip promotion.
HARBOR_STAGING_ENDPOINT=harbor-staging.example.com
HARBOR_PRODUCTION_ENDPOINT=
HARBOR_PROJECT=iicpc
HARBOR_USER=
HARBOR_PASSWORD=

# Optional build job image overrides
# KANIKO_IMAGE=gcr.io/kaniko-project/executor:v1.23.2
# TRIVY_IMAGE=aquasec/trivy:0.51.4
# SYFT_IMAGE=anchore/syft:v1.4.1

# Sandbox orchestration
SANDBOX_ORCHESTRATOR_URL=http://localhost:8087
CAPTURE_ENABLED=false
# CAPTURE_IMAGE=harbor.example.com/iicpc/ebpf-latency:latest
# ALGO_IMAGE_PULL_SECRET=

# Benchmark controller and bot fleet
MAX_TASKS_PER_WORKER=1000
MAX_BOTS_PER_WORKER=1000
MAX_POLL_INTERVAL_MS=1800000
DEPLOY_DEADLINE=60s
READY_DEADLINE=30s
BARRIER_SAFETY_GAP=500ms

# Scenario seeding. Set RESEED_SCENARIOS=true only when changing these values.
CONSTANT_DURATION_S=60
SPIKE_DURATION_S=60
RAMP_DURATION_S=180
CONSTANT_TOTAL_RPS=10000
SPIKE_PEAK_RPS=50000
RAMP_PEAK_RPS=90000
SPIKE_PREWINDOW_S=25
SPIKE_BURST_S=10
RESEED_SCENARIOS=false

# Telemetry aggregation
KAFKA_CONSUMER_GROUP=telemetry-ingester
WAVE_DURATION_MS=20000
SNAPSHOT_INTERVAL_MS=1000
TELEMETRY_BATCH_SIZE=4096
TELEMETRY_CHANNEL_CAPACITY=65536
TELEMETRY_FLUSH_INTERVAL_MS=5
