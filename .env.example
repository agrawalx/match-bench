# Copy this file to .env and fill in real values before running locally.
# docker-compose reads .env automatically.
# For k8s, values are injected via Secrets (see k8s/<namespace>/<service>/secret.yaml).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# docker-compose exposes postgres on 5433 (not 5432) to avoid conflicts with a local install.
DATABASE_URL=postgres://iicpc:iicpc@localhost:5433/iicpc

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=submissions
MINIO_USE_SSL=false

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Leave empty to disable Kafka publishing (submission-api and build-worker run in no-op mode).
# Add a Kafka service to docker-compose to enable full local testing.
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=build-worker

# ── Harbor (staging registry) ─────────────────────────────────────────────────
# Kaniko pushes built images here. Trivy and Syft read from here.
HARBOR_STAGING_ENDPOINT=harbor-staging.example.com
HARBOR_PROJECT=iicpc
HARBOR_USER=robot$iicpc
HARBOR_PASSWORD=changeme

# ── Harbor (production registry) ──────────────────────────────────────────────
# Spawner promotes verified images here via crane.Copy.
# Leave empty to skip promotion (safe for local dev and CI).
HARBOR_PRODUCTION_ENDPOINT=harbor.example.com

# ── build-worker / spawner (k8s prod only) ────────────────────────────────────
# Image used for the runner Job containers created by the spawner.
BUILD_WORKER_IMAGE=harbor.example.com/iicpc/build-worker:latest
K8S_NAMESPACE=build
